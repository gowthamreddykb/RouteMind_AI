FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=generate-a-strong-random-key-here
DATABASE_URL=sqlite:///instance/routemind.db
ORDER_CREATION_THRESHOLD=0.40
DISPATCH_THRESHOLD=0.39
PORT=5000

# SMTP Email Configuration (for Email OTP Authentication)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=RouteMind AI <no-reply@routemind.ai>

