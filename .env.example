FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=generate-a-strong-random-key-here
PORT=5000

# TiDB Cloud Serverless Connection String (MySQL 8.0 Compatible)
# Format: mysql+pymysql://<user>:<password>@<host>:4000/<database>?ssl_verify_cert=true&ssl_verify_identity=true
# Example:
# DATABASE_URL=mysql+pymysql://2abcdef.root:YourPassword@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/routemind?ssl_verify_cert=true&ssl_verify_identity=true
DATABASE_URL=sqlite:///instance/routemind.db

# Operational Thresholds
ORDER_CREATION_THRESHOLD=0.40
DISPATCH_THRESHOLD=0.39

# Cloud HTTPS Email Dispatch (Bypasses Render/AWS blocked SMTP port 587)
# Get a free API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-brevo-v3-api-key
# Or Resend API key (https://resend.com/api-keys)
# RESEND_API_KEY=re_your_resend_api_key

# Brevo (formerly Sendinblue) SMTP Configuration for OTP Authentication (for hosts allowing port 587)
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-brevo-account-email@example.com
MAIL_PASSWORD=xsmtpsib-your-brevo-master-smtp-key
MAIL_DEFAULT_SENDER=RouteMind AI <your-verified-brevo-sender@example.com>
MAIL_SUPPRESS_SEND=false
